{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubo.local/schemas/source-quality-policy.schema.json",
  "title": "KU-BO adaptive source quality policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "status",
    "dimensions",
    "thresholds",
    "hard_blocks",
    "adaptive_actions",
    "role_limits",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"const": "ku-bo-adaptive-source-quality-v1"},
    "status": {"const": "CONTRACT_ONLY"},
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension_id", "weight"],
        "properties": {
          "dimension_id": {
            "enum": [
              "authority",
              "rights_and_access",
              "point_in_time_integrity",
              "identity_binding",
              "parser_stability",
              "coverage_completeness",
              "publisher_independence"
            ]
          },
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admit", "corroboration_only", "quarantine_below"],
      "properties": {
        "admit": {"type": "number", "minimum": 0, "maximum": 1},
        "corroboration_only": {"type": "number", "minimum": 0, "maximum": 1},
        "quarantine_below": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "hard_blocks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}
    },
    "adaptive_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ADMIT", "CORROBORATION_ONLY", "QUARANTINE", "BLOCK"],
      "properties": {
        "ADMIT": {"type": "string"},
        "CORROBORATION_ONLY": {"type": "string"},
        "QUARANTINE": {"type": "string"},
        "BLOCK": {"type": "string"}
      }
    },
    "role_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["OFFICIAL_TRUTH", "SECONDARY_RESEARCH", "COMMUNITY_ROUTING_ONLY", "PRIVATE_STORAGE_ONLY"],
      "properties": {
        "OFFICIAL_TRUTH": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "SECONDARY_RESEARCH": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "COMMUNITY_ROUTING_ONLY": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "PRIVATE_STORAGE_ONLY": {"type": "array", "items": {"type": "string"}, "maxItems": 0}
      }
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_presence_proves_quality",
        "caller_supplied_source_role_is_authoritative",
        "drive_presence_grants_rights",
        "single_source_can_prove_market_view",
        "community_can_create_official_fact",
        "quality_score_is_probability",
        "quality_routing_grants_access_rights",
        "automatic_source_promotion_allowed"
      ],
      "properties": {
        "catalog_presence_proves_quality": {"const": false},
        "caller_supplied_source_role_is_authoritative": {"const": false},
        "drive_presence_grants_rights": {"const": false},
        "single_source_can_prove_market_view": {"const": false},
        "community_can_create_official_fact": {"const": false},
        "quality_score_is_probability": {"const": false},
        "quality_routing_grants_access_rights": {"const": false},
        "automatic_source_promotion_allowed": {"const": false}
      }
    }
  }
}
