{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubo.local/schemas/rights-aware-coverage-report.schema.json",
  "title": "KU-BO rights-aware backfill coverage report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "package_name",
    "market",
    "window",
    "counts",
    "attempted_source_ids",
    "blocked_sources",
    "unattempted_denominator_source_ids",
    "classification_counts",
    "gates",
    "training_cycle",
    "claim_boundaries",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "INCOMPLETE_RIGHTS_AWARE_RESEARCH_CONTEXT"},
    "package_name": {"const": "INCOMPLETE_RIGHTS_AWARE_RESEARCH_CONTEXT"},
    "market": {"const": "KUWAIT"},
    "window": {
      "const": {
        "inclusive_from": "2026-05-30",
        "inclusive_to": "2026-08-27",
        "day_count": 90
      }
    },
    "counts": {"$ref": "#/$defs/counts"},
    "attempted_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "blocked_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "classification", "blocker_code"],
        "properties": {
          "source_id": {"$ref": "#/$defs/identifier"},
          "classification": {
            "enum": ["BLOCKED_RIGHTS", "BLOCKED_ROBOTS", "BLOCKED_ACCESS"]
          },
          "blocker_code": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "unattempted_denominator_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "classification_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ADMITTED_RESEARCH_CONTEXT",
        "ADMITTED_TRAINING",
        "BLOCKED_RIGHTS",
        "BLOCKED_ROBOTS",
        "BLOCKED_ACCESS",
        "MISSING",
        "UNVERIFIED"
      ],
      "properties": {
        "ADMITTED_RESEARCH_CONTEXT": {"type": "integer", "minimum": 0},
        "ADMITTED_TRAINING": {"type": "integer", "minimum": 0},
        "BLOCKED_RIGHTS": {"type": "integer", "minimum": 0},
        "BLOCKED_ROBOTS": {"type": "integer", "minimum": 0},
        "BLOCKED_ACCESS": {"type": "integer", "minimum": 0},
        "MISSING": {"type": "integer", "minimum": 0},
        "UNVERIFIED": {"type": "integer", "minimum": 0}
      }
    },
    "gates": {
      "const": {
        "rights": "BLOCKED",
        "provenance": "NOT_RUN_NO_OBSERVATIONS",
        "publication_event_availability_timestamps": "NOT_RUN_NO_OBSERVATIONS",
        "immutable_hash": "PASS_SOURCE_RECEIPTS_ONLY",
        "point_in_time_availability": "NOT_RUN_NO_OBSERVATIONS",
        "temporal_leakage_test": "PASS_EMPTY_NO_ADMITTED_ROWS",
        "temporal_split": "NOT_RUN_NO_ADMITTED_ROWS",
        "dataset_release": "BLOCKED",
        "strict_forecast": "LOCKED"
      }
    },
    "training_cycle": {
      "const": {
        "status": "BLOCKED_DATASET_RELEASE",
        "current_step": "DATASET_RELEASE",
        "champion_update_allowed": false,
        "saudi_training_or_promotion_allowed": false
      }
    },
    "claim_boundaries": {
      "const": {
        "real_market_data_collected": false,
        "complete_training_dataset": false,
        "training_executed": false,
        "blind_test_executed": false,
        "forecast_generated": false,
        "schedule_active": false,
        "trade_submission_allowed": false
      }
    },
    "report_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_source_denominator",
        "attempted_denominator_sources",
        "unattempted_denominator_sources",
        "source_attempts",
        "blocked_sources",
        "planned_date_shards",
        "blocked_before_fetch_date_shards",
        "unattempted_date_shards",
        "unverified_date_shards",
        "completed_date_shards",
        "readable_raw_artifacts",
        "real_observations",
        "provenance_records",
        "unique_events",
        "research_context_records",
        "training_candidates",
        "contradictions"
      ],
      "properties": {
        "required_source_denominator": {"const": 11},
        "attempted_denominator_sources": {"type": "integer", "minimum": 0, "maximum": 11},
        "unattempted_denominator_sources": {"type": "integer", "minimum": 0, "maximum": 11},
        "source_attempts": {"type": "integer", "minimum": 0},
        "blocked_sources": {"type": "integer", "minimum": 0},
        "planned_date_shards": {"const": 990},
        "blocked_before_fetch_date_shards": {"type": "integer", "minimum": 0, "maximum": 990},
        "unattempted_date_shards": {"type": "integer", "minimum": 0, "maximum": 990},
        "unverified_date_shards": {"type": "integer", "minimum": 0, "maximum": 990},
        "completed_date_shards": {"const": 0},
        "readable_raw_artifacts": {"type": "integer", "minimum": 0},
        "real_observations": {"const": 0},
        "provenance_records": {"const": 0},
        "unique_events": {"const": 0},
        "research_context_records": {"const": 0},
        "training_candidates": {"const": 0},
        "contradictions": {"const": 0}
      }
    }
  }
}
