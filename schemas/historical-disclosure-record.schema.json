{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/historical-disclosure-record.schema.json",
  "title": "Immutable historical official disclosure record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","data_domain","immutability","record_id","security_code","canonical_cluster_id","record_type","headline","published_at","available_at","archived_at","official_source_url","evidence_sha256","corrects_record_id","supersedes_record_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "data_domain": {"const": "HISTORICAL_DISCLOSURE_ARCHIVE"},
    "immutability": {"const": "APPEND_ONLY"},
    "record_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "security_code": {"const": "HUMANSOFT"},
    "canonical_cluster_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "record_type": {"enum": ["ORIGINAL","CORRECTION","SUPPLEMENT","WITHDRAWAL"]},
    "headline": {"type": "string", "minLength": 1, "maxLength": 1000},
    "published_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "archived_at": {"type": "string", "format": "date-time"},
    "official_source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "corrects_record_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128},{"type": "null"}]},
    "supersedes_record_id": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128},{"type": "null"}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
