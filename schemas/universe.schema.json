{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/universe.schema.json",
  "title": "KU-BO Effective-Dated Security Identity and Universe Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reconciliation_status", "membership_basis", "membership_source_id", "membership_raw_sha256", "membership_as_of", "expected_security_codes", "covered_security_codes", "securities"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "reconciliation_status": {"const": "EXACT"},
    "membership_basis": {"const": "POINT_IN_TIME_OFFICIAL"},
    "membership_source_id": {"type": "string", "minLength": 1},
    "membership_raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "membership_as_of": {"type": "string", "format": "date-time"},
    "expected_security_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+$"}},
    "covered_security_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+$"}},
    "securities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["security_code", "ticker", "valid_from", "valid_to"],
        "properties": {
          "security_code": {"type": "string", "pattern": "^[0-9]+$"},
          "ticker": {"type": "string", "minLength": 1},
          "isin": {"type": ["string", "null"], "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
          "valid_from": {"type": "string", "format": "date"},
          "valid_to": {"type": ["string", "null"], "format": "date"}
        }
      }
    }
  }
}
