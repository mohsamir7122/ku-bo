{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/benchmark-evidence-manifest.schema.json",
  "title": "KU-BO preserved benchmark evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "3.0"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "sha256", "size_bytes", "source_id", "source_url",
        "observed_at", "capture_kind", "artifact_role", "benchmark_code",
        "availability_status", "rights_status", "evidence_classification"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^raw/[A-Za-z0-9][A-Za-z0-9._-]{0,254}$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "observed_at": {"type": "string", "format": "date-time"},
        "capture_kind": {
          "enum": [
            "ACCESS_RECEIPT", "RAW_DOWNLOAD", "USER_EXPORT",
            "RECORDED_AUTHORIZED_FIXTURE", "SYNTHETIC_GENERATED"
          ]
        },
        "artifact_role": {
          "enum": ["BENCHMARK_HISTORY_EXPORT", "BENCHMARK_SOURCE_ACCESS_RECEIPT"]
        },
        "benchmark_code": {"type": "string", "pattern": "^KU_BO_[A-Z0-9_]{1,58}$"},
        "availability_status": {"enum": ["AVAILABLE", "ZERO_RESULT", "UNAVAILABLE"]},
        "rights_status": {
          "enum": ["RESEARCH_USE_AUTHORIZED", "FIXTURE_ONLY", "UNKNOWN", "RESTRICTED"]
        },
        "evidence_classification": {
          "enum": [
            "PROVEN_REAL_EVIDENCE", "RECORDED_AUTHORIZED_FIXTURE",
            "SYNTHETIC_ONLY", "PARTIAL", "BLOCKED", "LIVE_DEPENDENT",
            "LICENSED_FEED_DEPENDENT"
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"capture_kind": {"const": "SYNTHETIC_GENERATED"}}},
          "then": {
            "properties": {
              "evidence_classification": {"const": "SYNTHETIC_ONLY"},
              "rights_status": {"const": "FIXTURE_ONLY"}
            }
          }
        },
        {
          "if": {"properties": {"capture_kind": {"const": "RECORDED_AUTHORIZED_FIXTURE"}}},
          "then": {
            "properties": {
              "evidence_classification": {"const": "RECORDED_AUTHORIZED_FIXTURE"},
              "rights_status": {"const": "FIXTURE_ONLY"}
            }
          }
        },
        {
          "if": {"properties": {"availability_status": {"const": "UNAVAILABLE"}}},
          "then": {
            "properties": {
              "capture_kind": {"const": "ACCESS_RECEIPT"},
              "artifact_role": {"const": "BENCHMARK_SOURCE_ACCESS_RECEIPT"}
            }
          },
          "else": {
            "properties": {
              "artifact_role": {"const": "BENCHMARK_HISTORY_EXPORT"}
            }
          }
        },
        {
          "if": {
            "required": ["evidence_classification"],
            "properties": {
              "evidence_classification": {"const": "PROVEN_REAL_EVIDENCE"}
            }
          },
          "then": {
            "properties": {
              "capture_kind": {"enum": ["RAW_DOWNLOAD", "USER_EXPORT"]},
              "artifact_role": {"const": "BENCHMARK_HISTORY_EXPORT"},
              "availability_status": {"enum": ["AVAILABLE", "ZERO_RESULT"]},
              "rights_status": {"const": "RESEARCH_USE_AUTHORIZED"}
            }
          }
        },
        {
          "if": {
            "required": ["evidence_classification"],
            "properties": {
              "evidence_classification": {"const": "LICENSED_FEED_DEPENDENT"}
            }
          },
          "then": {
            "properties": {"rights_status": {"enum": ["RESEARCH_USE_AUTHORIZED", "RESTRICTED"]}}
          }
        }
      ]
    }
  }
}
