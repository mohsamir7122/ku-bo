{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/tri-security-vendor-mappings.schema.json",
  "title": "KU-BO tri-security candidate vendor mappings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "as_of",
    "scope",
    "claim_boundary",
    "mappings"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "as_of": {"type": "string", "format": "date"},
    "scope": {"const": "TRI_SECURITY_PILOT_VENDOR_MAPPINGS"},
    "claim_boundary": {"const": "VENDOR_MAPPING_IS_NOT_OFFICIAL_SECURITY_IDENTITY"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "security_code",
        "ticker",
        "isin",
        "provider",
        "provider_symbol",
        "provider_url",
        "mapping_state",
        "evidence_notes"
      ],
      "properties": {
        "security_code": {"type": "string", "pattern": "^[0-9]{1,12}$"},
        "ticker": {"type": "string", "pattern": "^[A-Z][A-Z0-9]{0,31}$"},
        "isin": {"type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$"},
        "provider": {"const": "investing"},
        "provider_symbol": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-+[a-z0-9]+)*$"
        },
        "provider_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:www\\.)?investing\\.com/equities/[a-z0-9]+(?:-+[a-z0-9]+)*-historical-data$"
        },
        "mapping_state": {
          "enum": [
            "CANDIDATE_URL_OBSERVED",
            "CANDIDATE_NEEDS_CAPTURE",
            "VALIDATED_BY_RAW_CAPTURE",
            "RETIRED"
          ]
        },
        "evidence_notes": {"type": "string"}
      }
    }
  }
}
