{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/historical-event-record.schema.json",
  "title": "KU-BO source-bound historical event record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "year", "occurred_at", "date_precision", "published_at", "first_available_at", "captured_at", "scope", "event_type", "summary_ar", "summary_en", "source_evidence", "factual_status", "legal_status", "correction_status", "decision_use"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "pattern": "^hist-event-[0-9a-f]{24}$"},
    "year": {"type": "integer", "minimum": 1500},
    "occurred_at": {"type": ["string", "null"]},
    "date_precision": {"enum": ["DAY", "MONTH", "YEAR", "RANGE", "UNKNOWN"]},
    "published_at": {"type": ["string", "null"]},
    "first_available_at": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "scope": {"enum": ["KUWAIT", "SECTOR", "COMPANY", "PERSON"]},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "summary_ar": {"type": "string", "minLength": 1},
    "summary_en": {"type": ["string", "null"]},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "url", "content_sha256", "capture_sha256", "evidence_role"],
        "properties": {
          "source_id": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "capture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_role": {"enum": ["PRIMARY", "CORROBORATING", "CONTRADICTING", "ROUTING"]}
        }
      }
    },
    "factual_status": {"enum": ["OFFICIAL_CONFIRMED", "ARCHIVE_CORROBORATED", "MULTISOURCE_CORROBORATED", "UNCONFIRMED", "CONTESTED", "ROUTING_ONLY"]},
    "legal_status": {"enum": ["NOT_APPLICABLE", "ALLEGED", "REFERRED", "CHARGED", "DECIDED", "APPEALED", "FINAL"]},
    "correction_status": {"enum": ["CURRENT", "CORRECTED", "SUPERSEDED", "RETRACTED"]},
    "decision_use": {"const": "CONTEXT_ONLY"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"factual_status": {"const": "OFFICIAL_CONFIRMED"}},
        "required": ["factual_status"]
      },
      "then": {
        "properties": {
          "source_evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "source_id": {
                  "enum": [
                    "kuwait_government_history",
                    "kuwait_official_gazette",
                    "moci_commercial_registry",
                    "cma_kuwait",
                    "boursa_kuwait",
                    "central_bank_kuwait",
                    "kuwait_csb",
                    "ministry_justice_kuwait",
                    "nazaha_kuwait",
                    "kdipa_reports",
                    "koc_history",
                    "kia_history"
                  ]
                },
                "evidence_role": {"const": "PRIMARY"}
              },
              "required": ["source_id", "evidence_role"]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": ["LEGAL_ALLEGATION", "COURT_OUTCOME", "REGULATORY_ACTION"]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "legal_status": {
            "enum": ["ALLEGED", "REFERRED", "CHARGED", "DECIDED", "APPEALED", "FINAL"]
          }
        }
      }
    }
  ]
}
