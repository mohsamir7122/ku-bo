{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/source-access-probe-plan.schema.json",
  "title": "KU-BO source access capability probe plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "recipe_set_id", "recipe_set_sha256", "planned_at", "expires_at", "status", "purpose", "tasks", "claim_boundaries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^source-probe-plan-[0-9a-f]{24}$"},
    "recipe_set_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,95}$"},
    "recipe_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planned_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "status": {"const": "PLANNED_NOT_EXECUTED"},
    "purpose": {"const": "CAPABILITY_PROBE_ONLY"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "claim_boundaries": {"$ref": "#/$defs/claimBoundaries"}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "recipe_id", "source_id", "source_class", "tested_url", "access_mode", "capture_method", "purpose_class", "collection_frequency", "rights_status", "allowed_states", "terminal_reason_codes", "artifact_policy", "budget"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^probe-task-[0-9a-f]{24}$"},
        "recipe_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,95}$"},
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,95}$"},
        "source_class": {"enum": ["PRIMARY_OFFICIAL", "PRIMARY_ISSUER", "STRUCTURED_SECONDARY", "EDITORIAL", "COMMUNITY", "WEB_ARCHIVE", "SEARCH_ROUTER", "LICENSED", "STORAGE"]},
        "tested_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "access_mode": {"type": "string", "minLength": 1},
        "capture_method": {"enum": ["HTTP_GET", "BROWSER_RENDERED", "USER_EXPORT", "SEARCH_QUERY", "LICENSED_EXPORT"]},
        "purpose_class": {"enum": ["DISPLAY_OR_DISTRIBUTION", "NON_DISPLAY", "EXECUTION", "ROUTING_ONLY"]},
        "collection_frequency": {"enum": ["ONE_OFF", "SYSTEMATIC"]},
        "rights_status": {"enum": ["PUBLIC_ACCESS_ONLY", "AUTHORIZED", "LICENSED", "USER_SUPPLIED_AUTHORIZED_EXPORT"]},
        "allowed_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["AVAILABLE", "PARTIAL", "BLOCKED", "ERROR", "AUTH_REQUIRED", "UNTESTED"]}},
        "terminal_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}},
        "artifact_policy": {"const": "REQUIRED_WHEN_READABLE"},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_attempts", "timeout_seconds", "max_bytes"],
          "properties": {
            "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 60},
            "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
          }
        }
      }
    },
    "claimBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_access_executed", "market_data_collected", "market_evidence_created", "live_operational_claim_allowed", "forecast_or_recommendation_allowed", "probe_may_bypass_access_controls"],
      "properties": {
        "network_access_executed": {"const": false},
        "market_data_collected": {"const": false},
        "market_evidence_created": {"const": false},
        "live_operational_claim_allowed": {"const": false},
        "forecast_or_recommendation_allowed": {"const": false},
        "probe_may_bypass_access_controls": {"const": false}
      }
    }
  }
}
