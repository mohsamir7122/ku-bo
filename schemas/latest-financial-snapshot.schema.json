{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/latest-financial-snapshot.schema.json",
  "title": "Latest current financial snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","data_domain","mutability","purpose","snapshot_id","security_code","reporting_period_end","published_at","available_at","snapshot_as_of","source_url","evidence_sha256","metrics","historical_reaction_input_allowed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "data_domain": {"const": "LATEST_FINANCIAL_SNAPSHOT"},
    "mutability": {"const": "REPLACE_BY_NEWER_SNAPSHOT"},
    "purpose": {"const": "CURRENT_FINANCIAL_CONTEXT_ONLY"},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "security_code": {"const": "HUMANSOFT"},
    "reporting_period_end": {"type": "string", "format": "date"},
    "published_at": {"type": "string", "format": "date-time"},
    "available_at": {"type": "string", "format": "date-time"},
    "snapshot_as_of": {"type": "string", "format": "date-time"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "evidence_sha256": {"$ref": "#/$defs/sha256"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "historical_reaction_input_allowed": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id","value","unit","currency"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "currency": {"type": "string", "minLength": 1, "maxLength": 16}
      }
    }
  }
}
