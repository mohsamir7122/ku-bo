        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 12}, "wave_ordinal": {"const": 5}, "wave_id": {"const": "STRUCTURED_SECONDARY"}, "source_id": {"const": "mubasher_kuwait"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 13}, "wave_ordinal": {"const": 5}, "wave_id": {"const": "STRUCTURED_SECONDARY"}, "source_id": {"const": "argaam_kuwait"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 14}, "wave_ordinal": {"const": 5}, "wave_id": {"const": "STRUCTURED_SECONDARY"}, "source_id": {"const": "tradingview_screeners"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 15}, "wave_ordinal": {"const": 5}, "wave_id": {"const": "STRUCTURED_SECONDARY"}, "source_id": {"const": "marketscreener_kuwait"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 16}, "wave_ordinal": {"const": 5}, "wave_id": {"const": "STRUCTURED_SECONDARY"}, "source_id": {"const": "alphastocks_authorized_connector"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 17}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "reuters_middle_east"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 18}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "kuna"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 19}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "alqabas_economy"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 20}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "alanba_economy"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 21}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "alrai_economy"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 22}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "aljarida_economy"}}}]},
