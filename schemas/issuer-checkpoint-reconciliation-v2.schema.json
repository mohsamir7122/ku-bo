    "terminal_status_counts": {"$ref": "#/$defs/terminalStatusCounts"},
    "retained_manifest_count": {"const": 29},
    "reopened_manifest_count": {"const": 29},
    "raw_artifact_count": {"type": "integer", "minimum": 0},
    "reopened_raw_artifact_count": {"type": "integer", "minimum": 0},
    "raw_size_bytes": {"type": "integer", "minimum": 0},
    "reconciled_checkpoint_digest": {"$ref": "#/$defs/sha256"},
    "claim_boundaries": {"$ref": "#/$defs/claimBoundaries"},
    "reconciliation_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$"
    },
    "securityCode": {"type": "string", "pattern": "^[0-9]{1,12}$"},
    "terminalStatus": {
      "enum": [
        "COLLECTED",
        "VERIFIED_ZERO",
        "REVIEWED_NOT_APPLICABLE",
        "BLOCKED_RIGHTS",
        "BLOCKED_ROBOTS",
        "BLOCKED_ACCESS",
        "AUTH_REQUIRED",
        "ENTITLEMENT_REQUIRED",
        "PAYWALL",
        "RATE_LIMITED_EXHAUSTED",
        "NETWORK_ERROR_EXHAUSTED",
        "PARSER_DRIFT",
        "ISSUER_OFFICIAL_SITE_UNRESOLVED"
      ]
    },
    "receiptInventoryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ordinal",
        "wave_ordinal",
        "wave_id",
        "source_id",
        "terminal_status",
        "receipt_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 29},
        "wave_ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "wave_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,127}$"},
        "terminal_status": {"$ref": "#/$defs/terminalStatus"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "waveReconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wave_ordinal",
        "wave_id",
        "expected_source_ordinals",
        "terminal_source_ordinals",
        "status"
      ],
      "properties": {
        "wave_ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "wave_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "expected_source_ordinals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 29}
        },
        "terminal_source_ordinals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 29}
        },
        "status": {"const": "EXACT"}
      }
    },
    "terminalStatusCounts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 13,
      "properties": {
        "COLLECTED": {"type": "integer", "minimum": 1, "maximum": 29},
        "VERIFIED_ZERO": {"type": "integer", "minimum": 1, "maximum": 29},
        "REVIEWED_NOT_APPLICABLE": {"type": "integer", "minimum": 1, "maximum": 29},
        "BLOCKED_RIGHTS": {"type": "integer", "minimum": 1, "maximum": 29},
        "BLOCKED_ROBOTS": {"type": "integer", "minimum": 1, "maximum": 29},
        "BLOCKED_ACCESS": {"type": "integer", "minimum": 1, "maximum": 29},
        "AUTH_REQUIRED": {"type": "integer", "minimum": 1, "maximum": 29},
        "ENTITLEMENT_REQUIRED": {"type": "integer", "minimum": 1, "maximum": 29},
        "PAYWALL": {"type": "integer", "minimum": 1, "maximum": 29},
        "RATE_LIMITED_EXHAUSTED": {"type": "integer", "minimum": 1, "maximum": 29},
        "NETWORK_ERROR_EXHAUSTED": {"type": "integer", "minimum": 1, "maximum": 29},
        "PARSER_DRIFT": {"type": "integer", "minimum": 1, "maximum": 29},
        "ISSUER_OFFICIAL_SITE_UNRESOLVED": {"type": "integer", "minimum": 1, "maximum": 29}
      }
    },
    "claimBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_fixture_is_real_market_evidence",
        "checkpoint_structure_proves_production_durability",
        "terminal_receipts_prove_live_source_access",
        "terminal_receipts_prove_source_rights",
        "terminal_seal_proves_market_completeness",
        "sealed_fixture_unlocks_training_or_backtest",
        "sealed_fixture_proves_forecast_or_recommendation_quality",
        "sealed_fixture_authorizes_financial_execution"
      ],
      "properties": {
        "generated_fixture_is_real_market_evidence": {"const": false},
        "checkpoint_structure_proves_production_durability": {"const": false},
        "terminal_receipts_prove_live_source_access": {"const": false},
        "terminal_receipts_prove_source_rights": {"const": false},
        "terminal_seal_proves_market_completeness": {"const": false},
        "sealed_fixture_unlocks_training_or_backtest": {"const": false},
        "sealed_fixture_proves_forecast_or_recommendation_quality": {"const": false},
        "sealed_fixture_authorizes_financial_execution": {"const": false}
      }
    }
  }
}
