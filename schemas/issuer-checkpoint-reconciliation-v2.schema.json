        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 24}, "wave_ordinal": {"const": 6}, "wave_id": {"const": "EDITORIAL_CONTEXT"}, "source_id": {"const": "asharq_business"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 25}, "wave_ordinal": {"const": 7}, "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"}, "source_id": {"const": "indexsignal_forum"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 26}, "wave_ordinal": {"const": 7}, "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"}, "source_id": {"const": "telegram_boursakw"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 27}, "wave_ordinal": {"const": 7}, "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"}, "source_id": {"const": "telegram_kuwaitstockex"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 28}, "wave_ordinal": {"const": 7}, "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"}, "source_id": {"const": "telegram_kuwaitse"}}}]},
        {"allOf": [{"$ref": "#/$defs/receiptInventoryRow"}, {"properties": {"source_ordinal": {"const": 29}, "wave_ordinal": {"const": 7}, "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"}, "source_id": {"const": "web_search_router"}}}]}
      ],
      "items": false
    },
    "wave_reconciliation": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 1},
                "wave_id": {"const": "OFFICIAL_IDENTITY"},
                "expected_source_ordinals": {"minItems": 2, "maxItems": 2, "prefixItems": [{"const": 1}, {"const": 2}], "items": false},
                "terminal_source_ordinals": {"minItems": 2, "maxItems": 2, "prefixItems": [{"const": 1}, {"const": 2}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 2},
                "wave_id": {"const": "ISSUER_PRIMARY"},
                "expected_source_ordinals": {"minItems": 1, "maxItems": 1, "prefixItems": [{"const": 3}], "items": false},
                "terminal_source_ordinals": {"minItems": 1, "maxItems": 1, "prefixItems": [{"const": 3}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 3},
                "wave_id": {"const": "OFFICIAL_MARKET_FILINGS_AND_ACTIONS"},
                "expected_source_ordinals": {"minItems": 3, "maxItems": 3, "prefixItems": [{"const": 4}, {"const": 5}, {"const": 6}], "items": false},
                "terminal_source_ordinals": {"minItems": 3, "maxItems": 3, "prefixItems": [{"const": 4}, {"const": 5}, {"const": 6}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 4},
                "wave_id": {"const": "LICENSED_AND_AUTHORIZED_MARKET_DATA"},
                "expected_source_ordinals": {"minItems": 3, "maxItems": 3, "prefixItems": [{"const": 7}, {"const": 8}, {"const": 9}], "items": false},
                "terminal_source_ordinals": {"minItems": 3, "maxItems": 3, "prefixItems": [{"const": 7}, {"const": 8}, {"const": 9}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 5},
                "wave_id": {"const": "STRUCTURED_SECONDARY"},
                "expected_source_ordinals": {"minItems": 7, "maxItems": 7, "prefixItems": [{"const": 10}, {"const": 11}, {"const": 12}, {"const": 13}, {"const": 14}, {"const": 15}, {"const": 16}], "items": false},
                "terminal_source_ordinals": {"minItems": 7, "maxItems": 7, "prefixItems": [{"const": 10}, {"const": 11}, {"const": 12}, {"const": 13}, {"const": 14}, {"const": 15}, {"const": 16}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 6},
                "wave_id": {"const": "EDITORIAL_CONTEXT"},
                "expected_source_ordinals": {"minItems": 8, "maxItems": 8, "prefixItems": [{"const": 17}, {"const": 18}, {"const": 19}, {"const": 20}, {"const": 21}, {"const": 22}, {"const": 23}, {"const": 24}], "items": false},
                "terminal_source_ordinals": {"minItems": 8, "maxItems": 8, "prefixItems": [{"const": 17}, {"const": 18}, {"const": 19}, {"const": 20}, {"const": 21}, {"const": 22}, {"const": 23}, {"const": 24}], "items": false}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/waveReconciliation"},
            {
              "properties": {
                "wave_ordinal": {"const": 7},
                "wave_id": {"const": "DISCOVERY_AND_SENTIMENT_ONLY"},
                "expected_source_ordinals": {"minItems": 5, "maxItems": 5, "prefixItems": [{"const": 25}, {"const": 26}, {"const": 27}, {"const": 28}, {"const": 29}], "items": false},
                "terminal_source_ordinals": {"minItems": 5, "maxItems": 5, "prefixItems": [{"const": 25}, {"const": 26}, {"const": 27}, {"const": 28}, {"const": 29}], "items": false}
              }
            }
          ]
        }
      ],
      "items": false
