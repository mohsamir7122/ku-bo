{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubo.local/schemas/issuer-security-checkpoint-v2.schema.json",
  "title": "KU-BO synthetic one-security append-only checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "checkpoint_id", "policy_id", "policy_sha256",
    "run_id", "plan_id", "plan_sha256", "issuer_universe_sha256", "market",
    "security", "status", "revision", "generation", "fencing_token",
    "owner_run_id", "created_at", "updated_at", "source_slots",
    "reconciliation", "terminal_seal", "prior_checkpoint_digest",
    "checkpoint_digest", "production_authorized", "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "issuer-security-checkpoint-v2"},
    "checkpoint_id": {"type": "string", "pattern": "^ISCP2-[A-F0-9]{24}$"},
    "policy_id": {"const": "ku-bo-issuer-security-checkpoint-v2"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "issuer_universe_sha256": {"$ref": "#/$defs/sha256"},
    "market": {"const": "BOURSA_KUWAIT"},
    "security": {"$ref": "#/$defs/security"},
    "status": {"enum": ["RUNNING", "PREEMPTED", "RECONCILED", "SEALED"]},
    "revision": {"type": "integer", "minimum": 1},
    "generation": {"type": "integer", "minimum": 1},
    "fencing_token": {"$ref": "#/$defs/sha256"},
    "owner_run_id": {"$ref": "#/$defs/identifier"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_slots": {
      "type": "array", "minItems": 29, "maxItems": 29,
      "items": {"$ref": "#/$defs/sourceSlot"}
    },
    "reconciliation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "issuer-security-reconciliation.schema.json"}
      ]
    },
    "terminal_seal": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "issuer-security-terminal-seal.schema.json"}
      ]
    },
    "prior_checkpoint_digest": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
    },
    "checkpoint_digest": {"$ref": "#/$defs/sha256"},
    "production_authorized": {"const": false},
    "claim_boundaries": {
      "const": {
        "synthetic_checkpoint_is_live_operational": false,
        "content_digest_is_external_authentication": false,
        "checkpoint_grants_source_access": false,
        "checkpoint_grants_private_runtime_write_authority": false,
        "checkpoint_unlocks_training_backtest_forecast_or_execution": false,
        "terminal_seal_authorizes_a_second_security": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "issuer_id", "security_code", "ticker", "identity_sha256", "source_plan_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "issuer_id": {"$ref": "#/$defs/identifier"},
        "security_code": {"type": "string", "pattern": "^[0-9]+$"},
        "ticker": {"$ref": "#/$defs/identifier"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_plan_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "artifact_count", "raw_sha256s"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).*/?manifest\\.json$"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_count": {"type": "integer", "minimum": 1},
        "raw_sha256s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}
      }
    },
    "sourceSlot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_ordinal", "wave_ordinal", "wave_id", "source_id", "status",
        "attempt_count", "idempotency_key", "started_at", "completed_at",
        "source_receipt", "evidence_manifest"
      ],
      "properties": {
        "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 29},
        "wave_ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "wave_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "status": {"enum": ["PENDING", "IN_PROGRESS", "TERMINAL"]},
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "idempotency_key": {"$ref": "#/$defs/sha256"},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "source_receipt": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sourceReceipt"}]
        },
        "evidence_manifest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidenceManifest"}]}
      }
    },
    "sourceReceipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_ordinal", "wave_ordinal", "wave_id", "source_id",
        "terminal_status", "attempted_at", "completed_at", "artifact_count",
        "observation_count", "requested_domain", "activation_id",
        "entitlement_id", "artifact_manifest_sha256",
        "runtime_authority_bound", "authority_registry_id",
        "authority_registry_sha256", "authority_authenticated_key_id",
        "limitation", "security_code", "source_receipt_sha256"
      ],
      "properties": {
        "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 29},
        "wave_ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
        "wave_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "terminal_status": {
          "enum": [
            "COLLECTED", "VERIFIED_ZERO", "REVIEWED_NOT_APPLICABLE",
            "BLOCKED_RIGHTS", "BLOCKED_ROBOTS", "BLOCKED_ACCESS",
            "AUTH_REQUIRED", "ENTITLEMENT_REQUIRED", "PAYWALL",
            "RATE_LIMITED_EXHAUSTED", "NETWORK_ERROR_EXHAUSTED",
            "PARSER_DRIFT", "ISSUER_OFFICIAL_SITE_UNRESOLVED"
          ]
        },
        "attempted_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "artifact_count": {"type": "integer", "minimum": 0},
        "observation_count": {"type": "integer", "minimum": 0},
        "requested_domain": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "activation_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "entitlement_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "artifact_manifest_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "runtime_authority_bound": {"type": "boolean"},
        "authority_registry_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "authority_registry_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "authority_authenticated_key_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 255},
        "limitation": {"type": "string", "maxLength": 2000},
        "security_code": {"type": "string", "pattern": "^[0-9]+$"},
        "source_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
