{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/capture-plan.schema.json",
  "title": "KU-BO Capture Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connector", "source_id", "source_url", "roles_observed"],
        "properties": {
          "connector": {"enum": ["file", "public_http"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "roles_observed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "access_mode": {"enum": ["PUBLIC_PAGE", "PUBLIC_DOWNLOAD", "USER_EXPORT"]},
          "capture_kind": {"enum": ["RAW_PAGE", "RAW_DOWNLOAD", "USER_EXPORT", "ARCHIVE_CAPTURE"]},
          "resource_path": {"type": ["string", "null"]},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
          "max_bytes": {"type": "integer", "minimum": 1, "maximum": 52428800}
        }
      }
    }
  }
}
