{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/issuer-checkpoint-terminal-seal-v2.schema.json",
  "title": "KU-BO authenticated one-security checkpoint v2 terminal seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audience",
    "seal_id",
    "key_issuer_id",
    "issued_at",
    "checkpoint_id",
    "run_id",
    "market",
    "issuer_id",
    "security_code",
    "identity_sha256",
    "plan_sha256",
    "issuer_universe_sha256",
    "source_plan_sha256",
    "generation",
    "revision",
    "owner_run_id",
    "fencing_token",
    "terminal_checkpoint_digest",
    "reconciliation_sha256",
    "terminal_receipt_count",
    "wave_count",
    "bundle_inventory",
    "bundle_root_sha256",
    "previous_security_terminal_seal_sha256",
    "claim_boundaries",
    "authentication"
  ],
  "properties": {
    "schema_version": {"const": "issuer-checkpoint-terminal-seal-v2"},
    "audience": {"const": "kubo-one-security-checkpoint-v2"},
    "seal_id": {"$ref": "#/$defs/identifier"},
    "key_issuer_id": {"$ref": "#/$defs/identifier"},
    "issued_at": {"type": "string", "format": "date-time"},
    "checkpoint_id": {"$ref": "#/$defs/identifier"},
    "run_id": {"$ref": "#/$defs/identifier"},
    "market": {"const": "BOURSA_KUWAIT"},
    "issuer_id": {"$ref": "#/$defs/identifier"},
    "security_code": {"$ref": "#/$defs/securityCode"},
    "identity_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "issuer_universe_sha256": {"$ref": "#/$defs/sha256"},
    "source_plan_sha256": {"$ref": "#/$defs/sha256"},
    "generation": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "owner_run_id": {"$ref": "#/$defs/identifier"},
    "fencing_token": {"$ref": "#/$defs/sha256"},
    "terminal_checkpoint_digest": {"$ref": "#/$defs/sha256"},
    "reconciliation_sha256": {"$ref": "#/$defs/sha256"},
    "terminal_receipt_count": {"const": 29},
    "wave_count": {"const": 7},
    "bundle_inventory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/inventoryRow"}
    },
    "bundle_root_sha256": {"$ref": "#/$defs/sha256"},
    "previous_security_terminal_seal_sha256": {"$ref": "#/$defs/nullableSha256"},
    "claim_boundaries": {"$ref": "#/$defs/claimBoundaries"},
    "authentication": {"$ref": "#/$defs/authentication"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$"
    },
    "securityCode": {"type": "string", "pattern": "^[0-9]{1,12}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9._-]*\\.(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9._-]*\\.(?:/|$))[A-Za-z0-9._-]+)*$"
    },
    "inventoryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "claimBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_fixture_is_real_market_evidence",
        "checkpoint_structure_proves_production_durability",
        "terminal_receipts_prove_live_source_access",
        "terminal_receipts_prove_source_rights",
        "terminal_seal_proves_market_completeness",
        "sealed_fixture_unlocks_training_or_backtest",
        "sealed_fixture_proves_forecast_or_recommendation_quality",
        "sealed_fixture_authorizes_financial_execution"
      ],
      "properties": {
        "generated_fixture_is_real_market_evidence": {"const": false},
        "checkpoint_structure_proves_production_durability": {"const": false},
        "terminal_receipts_prove_live_source_access": {"const": false},
        "terminal_receipts_prove_source_rights": {"const": false},
        "terminal_seal_proves_market_completeness": {"const": false},
        "sealed_fixture_unlocks_training_or_backtest": {"const": false},
        "sealed_fixture_proves_forecast_or_recommendation_quality": {"const": false},
        "sealed_fixture_authorizes_financial_execution": {"const": false}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "tag"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "key_id": {"$ref": "#/$defs/identifier"},
        "tag": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
