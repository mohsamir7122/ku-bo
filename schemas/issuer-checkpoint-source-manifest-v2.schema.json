{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/issuer-checkpoint-source-manifest-v2.schema.json",
  "title": "KU-BO immutable one-security checkpoint v2 source artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "security_code",
    "source_ordinal",
    "wave_ordinal",
    "wave_id",
    "source_id",
    "artifacts",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "issuer-checkpoint-source-manifest-v2"},
    "checkpoint_id": {"$ref": "#/$defs/identifier"},
    "security_code": {"$ref": "#/$defs/securityCode"},
    "source_ordinal": {"type": "integer", "minimum": 1, "maximum": 29},
    "wave_ordinal": {"type": "integer", "minimum": 1, "maximum": 7},
    "wave_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{0,127}$"},
    "artifacts": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,254}$"
    },
    "securityCode": {"type": "string", "pattern": "^[0-9]{1,12}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9._-]*\\.(?:/|$))[A-Za-z0-9._-]+(?:/(?!\\.{1,2}(?:/|$))(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?![A-Za-z0-9._-]*\\.(?:/|$))[A-Za-z0-9._-]+)*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "allOf": [
            {"$ref": "#/$defs/safePath"},
            {"pattern": "^raw/[A-Za-z0-9._-]"}
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
      }
    }
  }
}
