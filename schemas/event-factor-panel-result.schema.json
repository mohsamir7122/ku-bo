{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/event-factor-panel-result.schema.json",
  "title": "KU-BO HUMANSOFT event-factor panel v1 result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "input_sha256",
    "packet_id",
    "errors",
    "warnings",
    "metrics",
    "diagnostics",
    "agreement_rate",
    "agreement_rate_status",
    "accuracy_claim_allowed",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "STOP_EVENT_STUDY"
    },
    "input_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "packet_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metrics": {
      "type": "null"
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_sessions",
        "post_sessions",
        "factor_rows",
        "observed_factor_rows",
        "unknown_factor_rows",
        "blocked_factor_rows"
      ],
      "properties": {
        "pre_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "post_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "factor_rows": {
          "type": "integer",
          "minimum": 0
        },
        "observed_factor_rows": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_factor_rows": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_factor_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "agreement_rate": {
      "type": "null"
    },
    "agreement_rate_status": {
      "const": "NOT_APPLICABLE"
    },
    "accuracy_claim_allowed": {
      "const": false
    },
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_study_is_prospective_accuracy",
        "retrospective_cross_horizon_is_production_accuracy",
        "independent_final_authority_receipt_verified",
        "corporate_actions_must_be_adjusted_or_explicit_none",
        "market_and_sector_benchmarks_are_required",
        "metrics_withheld_on_stop",
        "probability_generated"
      ],
      "properties": {
        "event_study_is_prospective_accuracy": {
          "const": false
        },
        "retrospective_cross_horizon_is_production_accuracy": {
          "const": false
        },
        "independent_final_authority_receipt_verified": {
          "const": false
        },
        "corporate_actions_must_be_adjusted_or_explicit_none": {
          "const": true
        },
        "market_and_sector_benchmarks_are_required": {
          "const": true
        },
        "metrics_withheld_on_stop": {
          "const": true
        },
        "probability_generated": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
