{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubo.local/schemas/live-dry-run-receipt.schema.json",
  "title": "KU-BO append-only dry-run stage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "stage",
    "status",
    "recorded_at",
    "previous_receipt_sha256",
    "input_sha256",
    "output_sha256",
    "reason_codes",
    "claim_boundaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 10},
    "stage": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "status": {"enum": ["PASS", "BLOCKED", "SKIPPED"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "previous_receipt_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "input_sha256": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "output_sha256": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "claim_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_collection_performed", "model_training_performed", "research_candidate_emitted", "recommendation_emitted"],
      "properties": {
        "network_collection_performed": {"const": false},
        "model_training_performed": {"const": false},
        "research_candidate_emitted": {"const": false},
        "recommendation_emitted": {"const": false}
      }
    }
  }
}
