{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohsamir7122/ku-bo/schemas/event-factor-panel.schema.json",
  "title": "KU-BO HUMANSOFT event-factor panel v1 packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "product_id",
    "timezone",
    "created_at",
    "evidence_classification",
    "rights_status",
    "policy",
    "event",
    "factor_snapshot",
    "pre_sessions",
    "post_sessions",
    "evidence_receipts",
    "independent_authority_receipt"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "product_id": {
      "const": "HUMANSOFT_EVENT_FACTOR_PANEL_V1"
    },
    "timezone": {
      "const": "Asia/Kuwait"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_classification": {
      "const": "PROVEN_REAL_EVIDENCE"
    },
    "rights_status": {
      "const": "RESEARCH_USE_AUTHORIZED"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_event_sessions",
        "post_event_sessions",
        "entry_rule",
        "price_basis",
        "benchmark_rule",
        "corporate_action_rule",
        "material_return_threshold_pct",
        "event_cluster_rule",
        "feature_cutoff_rule",
        "overlap_rule"
      ],
      "properties": {
        "pre_event_sessions": {
          "const": 20
        },
        "post_event_sessions": {
          "const": 20
        },
        "entry_rule": {
          "const": "FIRST_ELIGIBLE_CLOSE_AFTER_EVENT"
        },
        "price_basis": {
          "const": "TOTAL_RETURN_INDEX"
        },
        "benchmark_rule": {
          "const": "POINT_IN_TIME_MARKET_AND_SECTOR"
        },
        "corporate_action_rule": {
          "const": "ADJUSTED_OR_EXPLICIT_NONE"
        },
        "material_return_threshold_pct": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 100
        },
        "event_cluster_rule": {
          "const": "ONE_CANONICAL_EVENT_CLUSTER"
        },
        "feature_cutoff_rule": {
          "const": "AVAILABLE_AT_OR_BEFORE_EVENT"
        },
        "overlap_rule": {
          "const": "PURGE_AND_EMBARGO"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "security_code",
        "canonical_cluster_id",
        "event_type",
        "published_at",
        "available_at",
        "source_url",
        "evidence_sha256",
        "duplicate_of"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "security_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "canonical_cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "duplicate_of": {
          "type": "null"
        }
      }
    },
    "factor_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "snapshot_at",
        "evidence_sha256",
        "factors"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/factor"
          }
        }
      }
    },
    "pre_sessions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "post_sessions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "evidence_receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_ledger_sha256",
        "factor_snapshot_sha256",
        "trading_calendar_sha256",
        "price_history_sha256",
        "market_benchmark_sha256",
        "sector_benchmark_sha256",
        "corporate_actions_sha256"
      ],
      "properties": {
        "event_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "factor_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trading_calendar_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "price_history_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "market_benchmark_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sector_benchmark_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corporate_actions_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "independent_authority_receipt": {
      "type": "null"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factor_id",
        "state",
        "value",
        "available_at",
        "evidence_sha256"
      ],
      "properties": {
        "factor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "enum": [
            "OBSERVED",
            "UNKNOWN_NOT_OBSERVED",
            "BLOCKED"
          ]
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "available_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "OBSERVED"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "UNKNOWN_NOT_OBSERVED",
                  "BLOCKED"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trade_date",
        "session_close_at",
        "observed_at",
        "stock_total_return_index",
        "market_total_return_index",
        "sector_total_return_index",
        "volume",
        "calendar_evidence_sha256",
        "price_evidence_sha256",
        "market_benchmark_evidence_sha256",
        "sector_benchmark_evidence_sha256",
        "corporate_action_evidence_sha256"
      ],
      "properties": {
        "trade_date": {
          "type": "string",
          "format": "date"
        },
        "session_close_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "stock_total_return_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "market_total_return_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sector_total_return_index": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0
        },
        "calendar_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "price_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "market_benchmark_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sector_benchmark_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corporate_action_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
